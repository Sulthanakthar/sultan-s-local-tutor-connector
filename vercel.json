{
  "version": 2,
  "name": "peerbridge-local-tutor-connector",
  "builds": [
    {
      "src": "react-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "react-frontend/dist/$1"
    }
  ]
}
